#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: bin/bpytest [pytest args...]

Run pytest in the managed python-unit task on battleaxe. The wrapper remains a
host-side compatibility surface; the named task owns the executable prefix and
managed environment.

Examples (from implementations/python/sugar-lift-py-tests):
  ../../../bin/bpytest
  ../../../bin/bpytest -x tests/test_lift.py -k numpy

Environment: same BCARGO_* variables as bin/bcargo and bin/brun
(BCARGO_REMOTE_HOST, BCARGO_REMOTE_ROOT, BCARGO_SSH, BCARGO_RSYNC, ...).
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
sugarbin="$script_dir/sugarbin"
if [[ ! -x "$sugarbin" ]]; then
  echo "bpytest: missing engine script: $sugarbin" >&2
  exit 2
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  echo "bpytest: must be run from inside a git checkout" >&2
  exit 2
fi
repo_root="$(cd "$repo_root" && pwd -P)"

exec "$sugarbin" run --host bx --task python-unit -- "$@"
