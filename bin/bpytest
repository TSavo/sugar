#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: bin/bpytest [pytest args...]

Run pytest on battleaxe from the current repo-relative directory, via
bin/brun. The remote Python kit env (pytest + editable installs of every
implementations/python kit) is provisioned by `make bcargo-python-kit-env`
on the remote side; the Rust `sugar` binary resolves there through
bin/sugarbin, so a shelf/cell hit costs no compile and a miss builds on
battleaxe — never on this machine.

Examples (from implementations/python/sugar-lift-py-tests):
  ../../../bin/bpytest
  ../../../bin/bpytest -x tests/test_lift.py -k numpy

Environment: same BCARGO_* variables as bin/bcargo and bin/brun
(BCARGO_REMOTE_HOST, BCARGO_REMOTE_ROOT, BCARGO_SSH, BCARGO_RSYNC, ...).
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
brun="$script_dir/brun"
if [[ ! -x "$brun" ]]; then
  echo "bpytest: missing engine script: $brun" >&2
  exit 2
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  echo "bpytest: must be run from inside a git checkout" >&2
  exit 2
fi
repo_root="$(cd "$repo_root" && pwd -P)"

# Mirror brun's remote layout so the PATH prefix points at the remote Rust
# target dirs (freshly built sugar binaries are callable by the suite).
# These must stay in lockstep with bin/brun.
_bpytest_root_tag="$(printf '%s' "$repo_root" | shasum 2>/dev/null | cut -c1-12)"
_bpytest_root_tag="${_bpytest_root_tag:-default}"
remote_root="${BCARGO_REMOTE_ROOT:-/home/tsavo/remote/sugar-bcargo-${_bpytest_root_tag}}"
remote_repo="$remote_root/sugar"

exec "$brun" \
  --path-prefix "$remote_repo/implementations/rust/target/release" \
  --path-prefix "$remote_repo/implementations/rust/target/debug" \
  -- pytest "$@"
