#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: bcargo [bcargo options] [cargo args...]

Sync the Rust-facing Sugar workspace to battleaxe, then run Cargo there.

Options:
  --sync-bin NAME     After a successful cargo command, copy target/<profile>/NAME
                      back to the matching local target directory. Repeatable.
  --sync-bins LIST    Comma-separated form of --sync-bin.

Environment:
  BCARGO_REMOTE_HOST   SSH host alias to use (default: battleaxe)
  BCARGO_REMOTE_ROOT   Remote scratch root (default: /home/tsavo/remote/sugar-bcargo-<checkout-hash>)
  BCARGO_CLEAN_REMOTE_ROOT
                       Set to success or always to remove BCARGO_REMOTE_ROOT
                       after the remote cargo command. Default: never.
  BCARGO_CLEAN_REMOTE_ROOT_UNSAFE
                       Set to 1 to allow cleanup outside
                       /home/tsavo/remote/sugar-bcargo-*
  BCARGO_PYTHON_ENV    Set to 0 to skip remote Python kit env provisioning
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

sync_bins=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --sync-bin)
      if [[ $# -lt 2 ]]; then
        echo "bcargo: --sync-bin requires a binary name" >&2
        exit 2
      fi
      sync_bins+=("$2")
      shift 2
      ;;
    --sync-bins)
      if [[ $# -lt 2 ]]; then
        echo "bcargo: --sync-bins requires a comma-separated list" >&2
        exit 2
      fi
      IFS=',' read -r -a parsed_sync_bins <<<"$2"
      for bin in "${parsed_sync_bins[@]}"; do
        [[ -n "$bin" ]] && sync_bins+=("$bin")
      done
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done
cargo_args=("$@")

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  repo_root="$(cd "$script_dir/.." && pwd -P)"
fi
repo_root="$(cd "$repo_root" && pwd -P)"
local_cwd="$(pwd -P)"

case "$local_cwd" in
  "$repo_root")
    rel_cwd=""
    ;;
  "$repo_root"/*)
    rel_cwd="${local_cwd#"$repo_root"/}"
    ;;
  *)
    echo "bcargo: current directory is outside $repo_root" >&2
    exit 2
    ;;
esac

remote_host="${BCARGO_REMOTE_HOST:-battleaxe}"
remote_binary_platform="${BCARGO_REMOTE_BINARY_PLATFORM:-linux-x86_64}"
# Per-checkout remote root so concurrent worktrees/agents do not clobber each
# other. All checkouts previously shared one root, and `rsync -az --delete`
# from one wiped another's source mid-build (stale/false builds, stalls). Derive
# a stable suffix from the absolute checkout path so each worktree gets its own
# remote scratch; the shared sccache cache still gives cross-checkout reuse.
_bcargo_root_tag="$(printf '%s' "$repo_root" | shasum 2>/dev/null | cut -c1-12)"
_bcargo_root_tag="${_bcargo_root_tag:-default}"
remote_root="${BCARGO_REMOTE_ROOT:-/home/tsavo/remote/sugar-bcargo-${_bcargo_root_tag}}"
remote_repo="$remote_root/sugar"
remote_python_venv="$remote_root/python-kit-env"
remote_python_bin="$remote_python_venv/bin"
remote_python="$remote_python_bin/python"
provision_python_env="${BCARGO_PYTHON_ENV:-1}"
clean_remote_root="${BCARGO_CLEAN_REMOTE_ROOT:-never}"
clean_remote_root_unsafe="${BCARGO_CLEAN_REMOTE_ROOT_UNSAFE:-0}"
ssh_bin="${BCARGO_SSH:-ssh}"
rsync_bin="${BCARGO_RSYNC:-rsync}"

quote_sh() {
  printf "'"
  printf "%s" "$1" | sed "s/'/'\\\\''/g"
  printf "'"
}

remote_parent() {
  local path="$1"
  dirname "$path"
}

abs_from_cwd() {
  local path="$1"
  if [[ "$path" == /* ]]; then
    printf '%s\n' "$path"
  else
    printf '%s\n' "$local_cwd/$path"
  fi
}

remote_for_local_path() {
  local path="$1"
  case "$path" in
    "$repo_root")
      printf '%s\n' "$remote_repo"
      ;;
    "$repo_root"/*)
      printf '%s/%s\n' "$remote_repo" "${path#"$repo_root"/}"
      ;;
    *)
      printf '%s\n' "$path"
      ;;
  esac
}

sugar_binary_repo() {
  if [[ -n "${SUGAR_BINARY_REPO:-}" ]]; then
    printf '%s\n' "$SUGAR_BINARY_REPO"
    return 0
  fi
  command -v gh >/dev/null 2>&1 || return 0
  gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true
}

run_ssh() {
  "$ssh_bin" -o BatchMode=yes "$remote_host" "$@"
}

case "$clean_remote_root" in
  "" | 0 | false | no | never)
    clean_remote_root="never"
    ;;
  1 | true | yes | success)
    clean_remote_root="success"
    ;;
  always)
    ;;
  *)
    echo "bcargo: BCARGO_CLEAN_REMOTE_ROOT must be never, success, or always" >&2
    exit 2
    ;;
esac

if [[ "$clean_remote_root" != "never" ]]; then
  case "$remote_root" in
    /home/tsavo/remote/sugar-bcargo-*)
      ;;
    *)
      if [[ "$clean_remote_root_unsafe" != "1" ]]; then
        echo "bcargo: refusing to clean unsafe remote root: $remote_root" >&2
        echo "bcargo: set BCARGO_CLEAN_REMOTE_ROOT_UNSAFE=1 only for an explicitly disposable root" >&2
        exit 2
      fi
      ;;
  esac
fi

cleanup_remote_root() {
  run_ssh "rm -rf $(quote_sh "$remote_root")"
}

# Reap orphaned sibling roots. Remote roots are per-checkout (see above), so a
# deleted local worktree leaves its remote root behind forever; 97 of those
# once filled the disk to 0 and stalled every build on the box. Each run
# touches its own root (marking it live) and removes sugar-bcargo-* siblings
# nobody has touched in BCARGO_REAP_DAYS days. Best-effort and backgrounded on
# the remote so it never blocks or fails the build. Set BCARGO_REAP_DAYS=0 to
# disable.
reap_days="${BCARGO_REAP_DAYS:-2}"
reap_stale_remote_roots() {
  [[ "$reap_days" == "0" ]] && return 0
  run_ssh "mkdir -p $(quote_sh "$remote_root") && touch $(quote_sh "$remote_root") && nohup find /home/tsavo/remote -mindepth 1 -maxdepth 1 -name 'sugar-bcargo-*' ! -path $(quote_sh "$remote_root") -mtime +$(quote_sh "$reap_days") -exec rm -rf {} + >/dev/null 2>&1 &" || true
}

exclude_args=(
  # These are tiny checked-in proof fixtures, not local run products. The
  # includes must precede the generated-output excludes below so remote
  # integrity tests see the same trust-root corpus as local cargo.
  --include='/examples/serde-json-showcase/bad/.sugar/runs/***'
  --include='/examples/serde-json-showcase/good/.sugar/runs/***'
  --exclude='target/'
  --exclude='.git/'
  --exclude='.jj/'
  --exclude='.worktrees/'
  --exclude='.claude/'
  --exclude='.ruff_cache/'
  --exclude='.venv-test-rust/'
  --exclude='.understand-anything/'
  --exclude='node_modules/'
  --exclude='bazel-bin'
  --exclude='bazel-out'
  --exclude='bazel-sugar'
  --exclude='bazel-testlogs'
  --exclude='sugar-warnings/'
  --exclude='sugar-worktrees/'
  --exclude='.sugar/runs/'
  --exclude='.sugar/witnesses/'
  # NOTE: `.sugar/lift/` is intentionally NOT excluded. Those are the
  # hand-authored per-project lift manifests (tiny TOMLs naming the plugin
  # commands) that `sugar mint` needs; excluding them made remote mint
  # impossible. Only the generated `runs/` and `witnesses/` outputs are skipped.
)

# The full synced surface, as repo-root-relative paths. One rsync -R
# (relative) transfer ships all of them: the per-path sync_file/sync_dir
# helpers this replaced cost ~50 sequential ssh round trips and ~25 separate
# file-list walks per invocation. -R creates implied parent directories on
# the remote, and --delete applies within each listed tree.
#
# Notes on specific entries:
# - `.sugar/config.toml`, `.sugar/lift`, `.sugar/realize` are repo-root
#   workspace config and hand-authored plugin manifests: source inputs for
#   CLI dispatch. Generated `.sugar/` outputs (runs/, witnesses/, cache/,
#   baselines/, etc.) stay out via exclude_args, except the fixture includes
#   noted there.
# - `.sugar/components` holds checked-in kit component manifests. Component
#   discovery (component_plan.rs) reads `<project_root>/.sugar/components`
#   to decide which kit claims a workspace; without this, remote runs hit
#   "no Sugar <lang> kit component claimed it".
# - `editors/vscode-sugar/test/fixtures` are the extension's committed lift
#   fixtures: sugar-cli's bcargo sync-contract test demands they travel.
sync_paths=(
  Cargo.toml
  Cargo.lock
  Makefile
  sugar-release.toml
  bin/bcargo
  bin/sugarbin
  package.json
  pnpm-lock.yaml
  rust-toolchain
  rust-toolchain.toml
  .sugar/config.toml
  .sugar/lift
  .sugar/realize
  .sugar/ir-compilers
  .sugar/components
  .github
  implementations/rust
  implementations/python
  implementations/go
  implementations/java
  examples
  editors/vscode-sugar/test/fixtures
  menagerie/csharp-language-signature/specs
  menagerie/python-language-signature/specs
  tools
  protocol
  docs/perf
  docs/self-application
  scripts
  bootstrap
  conformance
  tests
)

sync_workspace() {
  local existing=() rel
  for rel in "${sync_paths[@]}"; do
    [[ -e "$repo_root/$rel" ]] && existing+=("$rel")
  done
  ((${#existing[@]})) || return 0
  run_ssh "mkdir -p $(quote_sh "$remote_repo")"
  (cd "$repo_root" && "$rsync_bin" -azR --delete "${exclude_args[@]}" "${existing[@]}" "$remote_host:$remote_repo/")
  sync_tracked_manifest
}

# The remote copy has no .git, but the sync-contract census needs to tell
# committed fixtures from run products generated on the remote (excluded
# paths survive --delete, so remote-generated .sugar/runs dirs persist).
# Ship the tracked-file list so the census can ask VCS-tracked-ness there.
sync_tracked_manifest() {
  local manifest
  manifest="$(mktemp)" || return 0
  if git -C "$repo_root" ls-files -z >"$manifest" 2>/dev/null; then
    "$rsync_bin" -az "$manifest" "$remote_host:$remote_repo/.bcargo-tracked-manifest"
  fi
  rm -f "$manifest"
}

remove_remote_dir() {
  local rel_path="$1"
  local remote_path="$remote_repo/$rel_path"

  run_ssh "rm -rf $(quote_sh "$remote_path")"
}

file_description() {
  local path="$1"
  if ! command -v file >/dev/null 2>&1; then
    return 1
  fi
  file -b "$path" 2>/dev/null || return 1
}

is_foreign_synced_binary() {
  local path="$1"
  local host_os
  host_os="$(uname -s 2>/dev/null || true)"
  if [[ "$host_os" == "Linux" ]]; then
    return 1
  fi
  local desc
  desc="$(file_description "$path" || true)"
  [[ "$desc" == *"ELF"* ]]
}

remove_stale_foreign_binary_if_present() {
  local path="$1"
  [[ -e "$path" ]] || return 0
  if is_foreign_synced_binary "$path"; then
    rm -f "$path"
  fi
}

warn_foreign_synced_binary() {
  local local_bin="$1"
  local tmp_bin="$2"
  local desc
  desc="$(file_description "$tmp_bin" || true)"
  desc="${desc:-unknown binary format}"
  echo "bcargo: refusing to deposit foreign-platform binary: crime=foreign-platform-binary owner=bin/bcargo shape=$desc path=$local_bin replacement=run the binary on $remote_host through bcargo, or cargo clean and rebuild locally with RUSTC_WRAPPER='' before local verdict checks" >&2
}

reap_stale_remote_roots

# Only the two menagerie specs dirs travel; clear the rest of the remote
# menagerie so stale content from older syncs never leaks into remote runs.
remove_remote_dir menagerie
sync_workspace

remote_cwd="$remote_repo"
if [[ -n "$rel_cwd" ]]; then
  remote_cwd="$remote_repo/$rel_cwd"
fi

profile="debug"
manifest_path=""
target_dir_arg=""
for ((i = 0; i < ${#cargo_args[@]}; i++)); do
  arg="${cargo_args[$i]}"
  case "$arg" in
    --release)
      profile="release"
      ;;
    --manifest-path)
      if (( i + 1 < ${#cargo_args[@]} )); then
        manifest_path="${cargo_args[$((i + 1))]}"
      fi
      ;;
    --manifest-path=*)
      manifest_path="${arg#--manifest-path=}"
      ;;
    --target-dir)
      if (( i + 1 < ${#cargo_args[@]} )); then
        target_dir_arg="${cargo_args[$((i + 1))]}"
      fi
      ;;
    --target-dir=*)
      target_dir_arg="${arg#--target-dir=}"
      ;;
  esac
done

if [[ -n "$target_dir_arg" ]]; then
  local_target_dir="$(abs_from_cwd "$target_dir_arg")"
  remote_target_dir="$(remote_for_local_path "$local_target_dir")"
elif [[ -n "$manifest_path" ]]; then
  local_manifest_path="$(abs_from_cwd "$manifest_path")"
  local_target_dir="$(dirname "$local_manifest_path")/target"
  remote_target_dir="$(remote_for_local_path "$local_target_dir")"
else
  local_target_dir="$local_cwd/target"
  remote_target_dir="$remote_cwd/target"
fi

sync_bin_requested() {
  local wanted="$1" bin
  local found=1
  set +u
  for bin in "${sync_bins[@]}"; do
    if [[ "$bin" == "$wanted" ]]; then
      found=0
      break
    fi
  done
  set -u
  return "$found"
}

sync_bin_count() {
  local count
  set +u
  count="${#sync_bins[@]}"
  set -u
  printf '%s\n' "$count"
}

sugar_source_stamp() {
  if [[ -n "${SUGAR_BINARY_SOURCE_STAMP:-}" ]]; then
    printf '%s\n' "$SUGAR_BINARY_SOURCE_STAMP"
    return 0
  fi
  "$repo_root/bin/sugarbin" --print-source-stamp
}

is_sugar_only_build_request() {
  [[ "${cargo_args[0]:-}" == "build" ]] || return 1
  [[ "$(sync_bin_count)" -eq 1 ]] || return 1
  local package_ok=0 bin_ok=0 other_package=0 other_bin=0 i arg value
  for ((i = 0; i < ${#cargo_args[@]}; i++)); do
    arg="${cargo_args[$i]}"
    case "$arg" in
      -p | --package)
        if ((i + 1 >= ${#cargo_args[@]})); then
          return 1
        fi
        value="${cargo_args[$((i + 1))]}"
        if [[ "$value" == "sugar-cli" ]]; then
          package_ok=1
        else
          other_package=1
        fi
        i=$((i + 1))
        ;;
      -p=* | --package=*)
        value="${arg#*=}"
        if [[ "$value" == "sugar-cli" ]]; then
          package_ok=1
        else
          other_package=1
        fi
        ;;
      --bin)
        if ((i + 1 >= ${#cargo_args[@]})); then
          return 1
        fi
        value="${cargo_args[$((i + 1))]}"
        if [[ "$value" == "sugar" ]]; then
          bin_ok=1
        else
          other_bin=1
        fi
        i=$((i + 1))
        ;;
      --bin=*)
        value="${arg#*=}"
        if [[ "$value" == "sugar" ]]; then
          bin_ok=1
        else
          other_bin=1
        fi
        ;;
    esac
  done
  [[ "$package_ok" == "1" && "$bin_ok" == "1" && "$other_package" == "0" && "$other_bin" == "0" ]]
}

sugar_stamp=""
if sync_bin_requested sugar; then
  sugar_stamp="$(sugar_source_stamp)"
fi
resolved_sugar_binary_repo="$(sugar_binary_repo)"

remote_sugarbin_assignments() {
  local stamp="$1"
  printf 'SUGAR_BINARY_SOURCE_STAMP=%s ' "$(quote_sh "$stamp")"
  printf 'SUGAR_BINARY_TARGET_ROOT=%s ' "$(quote_sh "$remote_target_dir")"
  if [[ -n "$resolved_sugar_binary_repo" ]]; then
    printf 'SUGAR_BINARY_REPO=%s ' "$(quote_sh "$resolved_sugar_binary_repo")"
  fi
}

remote_sugarbin_pull() {
  local stamp="$1"
  local remote_bin="$remote_target_dir/$profile/sugar"
  local cmd
  cmd="cd $(quote_sh "$remote_repo") && "
  cmd+="resolved=\"\$($(remote_sugarbin_assignments "$stamp")"
  cmd+="SUGAR_BINARY_ALLOW_BUILD='0' "
  cmd+="bin/sugarbin --profile $(quote_sh "$profile") --platform $(quote_sh "$remote_binary_platform"))\""
  cmd+=" && mkdir -p $(quote_sh "$(dirname "$remote_bin")")"
  cmd+=" && if [ \"\$resolved\" != $(quote_sh "$remote_bin") ]; then cp \"\$resolved\" $(quote_sh "$remote_bin"); fi"
  cmd+=" && chmod +x $(quote_sh "$remote_bin")"
  run_ssh "bash -lc $(quote_sh "$cmd")"
}

remote_sugarbin_publish() {
  local stamp="$1"
  local cmd
  cmd="cd $(quote_sh "$remote_repo") && "
  cmd+="$(remote_sugarbin_assignments "$stamp")"
  cmd+="SUGAR_BINARY_ALLOW_BUILD='0' "
  cmd+="bin/sugarbin --profile $(quote_sh "$profile") --platform $(quote_sh "$remote_binary_platform") >/dev/null"
  run_ssh "bash -lc $(quote_sh "$cmd")"
}

remote_args=()
for arg in "$@"; do
  if [[ "$arg" == "$repo_root" ]]; then
    arg="$remote_repo"
  elif [[ "$arg" == "$repo_root"/* ]]; then
    arg="$remote_repo/${arg#"$repo_root"/}"
  fi
  remote_args+=("$(quote_sh "$arg")")
done

provision_steps=()
cargo_env=()
path_prefix="$remote_target_dir/$profile"
build_git_head="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || true)"
if [[ -n "$build_git_head" ]]; then
  cargo_env+=("SUGAR_BUILD_GIT_HEAD=$(quote_sh "$build_git_head")")
fi
if [[ "$provision_python_env" != "0" ]]; then
  provision_steps+=("BCARGO_PYTHON_VENV=$(quote_sh "$remote_python_venv") make --quiet bcargo-python-kit-env")
  cargo_env+=("PYTHON=$(quote_sh "$remote_python")")
  path_prefix="$path_prefix:$remote_python_bin"
fi
if [[ -n "$sugar_stamp" ]]; then
  cargo_env+=("SUGAR_BUILD_STAMP=$(quote_sh "$sugar_stamp")")
fi
cargo_env+=("PATH=$(quote_sh "$path_prefix"):\$PATH")

if ((${#provision_steps[@]} == 0)); then
  inner="cd $(quote_sh "$remote_cwd") && "
  for assignment in "${cargo_env[@]}"; do
    inner+="$assignment "
  done
  inner+="exec cargo"
else
  inner="cd $(quote_sh "$remote_repo")"
  for step in "${provision_steps[@]}"; do
    inner+=" && $step"
  done
  inner+=" && cd $(quote_sh "$remote_cwd") && "
  for assignment in "${cargo_env[@]}"; do
    inner+="$assignment "
  done
  inner+="exec cargo"
fi
for arg in "${remote_args[@]}"; do
  inner+=" $arg"
done

sugar_cell_ready=0
skip_remote_cargo=0
if [[ -n "$sugar_stamp" ]]; then
  if remote_sugarbin_pull "$sugar_stamp"; then
    sugar_cell_ready=1
    if is_sugar_only_build_request; then
      skip_remote_cargo=1
    fi
  fi
fi

if [[ "$skip_remote_cargo" == "1" ]]; then
  status=0
else
  set +e
  run_ssh "bash -lc $(quote_sh "$inner")"
  status=$?
  set -e
fi

if [[ "$status" -ne 0 ]]; then
  if [[ "$clean_remote_root" == "always" ]]; then
    if ! cleanup_remote_root; then
      echo "bcargo: remote root cleanup failed after cargo failure: $remote_root" >&2
    fi
  fi
  exit "$status"
fi

if sync_bin_requested sugar && [[ "$sugar_cell_ready" != "1" ]]; then
  if ! remote_sugarbin_publish "$sugar_stamp"; then
    echo "bcargo: remote sugarbin publish did not complete for stamp $sugar_stamp" >&2
  fi
fi

if (($(sync_bin_count) > 0)); then
  set +u
  bins_to_sync=("${sync_bins[@]}")
  set -u
  for bin in "${bins_to_sync[@]}"; do
    remote_bin="$remote_target_dir/$profile/$bin"
    local_bin="$local_target_dir/$profile/$bin"
    mkdir -p "$(dirname "$local_bin")"
    tmp_local_bin="$(mktemp "${local_bin}.bcargo-sync.XXXXXX")"
    "$rsync_bin" -az "$remote_host:$remote_bin" "$tmp_local_bin"
    if is_foreign_synced_binary "$tmp_local_bin"; then
      warn_foreign_synced_binary "$local_bin" "$tmp_local_bin"
      rm -f "$tmp_local_bin"
      remove_stale_foreign_binary_if_present "$local_bin"
      continue
    fi
    mv -f "$tmp_local_bin" "$local_bin"
  done
fi

if [[ "$clean_remote_root" != "never" ]]; then
  cleanup_remote_root
fi
