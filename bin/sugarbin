#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=bin/lib/sugar-exec.sh
source "$script_dir/lib/sugar-exec.sh"

sugarbin_contract_python() {
  if command -v python3.12 >/dev/null 2>&1; then printf '%s\n' python3.12; return; fi
  if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 12))'; then
    printf '%s\n' python3
    return
  fi
  echo "sugarbin: Python 3.12 or newer is required to resolve sugar-build.toml" >&2
  return 2
}

dispatch_execution_subcommand() {
  local subcommand="$1"
  shift

  local host="local"
  local execution_env="ambient"
  local requested_platform=""
  local needs=""
  local task=""
  local saw_boundary=0
  local -a command=()
  local -a path_prefixes=() env_names=() sync_backs=()
  local -a sync_bins=()
  local python_env_flag=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host)
        [[ $# -ge 2 ]] || { echo "sugarbin: --host requires a value" >&2; return 2; }
        host="$2"
        shift 2
        ;;
      --env)
        [[ $# -ge 2 ]] || { echo "sugarbin: --env requires a value" >&2; return 2; }
        if [[ "$2" == ambient || "$2" == docker || "$2" == docker:* ]]; then
          execution_env="$2"
        else
          local -a parsed_env=()
          IFS=',' read -r -a parsed_env <<<"$2"
          env_names+=("${parsed_env[@]}")
        fi
        shift 2
        ;;
      --path-prefix)
        [[ $# -ge 2 ]] || { echo "sugarbin: --path-prefix requires a value" >&2; return 2; }
        path_prefixes+=("$2"); shift 2 ;;
      --sync-back)
        [[ $# -ge 2 && "$2" == /*:/* ]] || { echo "sugarbin: --sync-back requires REMOTE:LOCAL" >&2; return 2; }
        sync_backs+=("$2"); shift 2 ;;
      --sync-bin)
        [[ "$subcommand" == cargo && $# -ge 2 ]] || { echo "sugarbin: --sync-bin requires a binary name" >&2; return 2; }
        sync_bins+=("$2"); shift 2 ;;
      --sync-bins)
        [[ "$subcommand" == cargo && $# -ge 2 ]] || { echo "sugarbin: --sync-bins requires a comma-separated list" >&2; return 2; }
        local -a parsed_sync_bins=()
        IFS=',' read -r -a parsed_sync_bins <<<"$2"
        local bin
        for bin in "${parsed_sync_bins[@]}"; do [[ -z "$bin" ]] || sync_bins+=("$bin"); done
        shift 2 ;;
      --no-python-env)
        python_env_flag=0; shift ;;
      --platform)
        [[ $# -ge 2 ]] || { echo "sugarbin: --platform requires a value" >&2; return 2; }
        requested_platform="$2"
        shift 2
        ;;
      --needs)
        [[ $# -ge 2 ]] || { echo "sugarbin: --needs requires a value" >&2; return 2; }
        needs="$2"
        shift 2
        ;;
      --task)
        [[ "$subcommand" == run || "$subcommand" == explain ]] || { echo "sugarbin: --task is only valid for run and explain" >&2; return 2; }
        [[ $# -ge 2 ]] || { echo "sugarbin: --task requires a value" >&2; return 2; }
        task="$2"
        shift 2
        ;;
      --)
        saw_boundary=1
        shift
        command=("$@")
        break
        ;;
      *)
        echo "sugarbin: unknown $subcommand argument: $1" >&2
        return 2
        ;;
    esac
  done

  [[ "$subcommand" != build || -n "$needs" ]] || needs="sugar"

  local task_json="" task_capabilities="" task_needs=""
  local -a task_command=()
  if [[ -n "$task" ]]; then
    local contract_python
    contract_python="$(sugarbin_contract_python)" || return $?
    task_json="$("$contract_python" "$script_dir/../tools/sugar-build/contract.py" resolve-task "$task")" || return $?
    task_capabilities="$("$contract_python" -c 'import json,sys; print(",".join(json.load(sys.stdin)["capabilities"]))' <<<"$task_json")"
    task_needs="$("$contract_python" -c 'import json,sys; print(",".join(json.load(sys.stdin)["binaries"]))' <<<"$task_json")"
    while IFS= read -r -d '' arg; do task_command+=("$arg"); done < <("$contract_python" -c 'import json,sys; [sys.stdout.write(x+"\0") for x in json.load(sys.stdin)["command"]]' <<<"$task_json")
    if [[ -n "$needs" ]]; then
      local normalized_needs
      normalized_needs="$(tr ',' '\n' <<<"$needs" | LC_ALL=C sort -u | paste -sd, -)"
      [[ "$normalized_needs" == "$task_needs" ]] || { echo "sugarbin: --task binaries contradict --needs" >&2; return 2; }
    else
      needs="$task_needs"
    fi
    if ((${#command[@]})); then
      command=("${task_command[@]}" "${command[@]}")
    else
      command=("${task_command[@]}")
    fi
    # A named task on the managed remote owns its capability closure; wrappers
    # do not recreate that environment policy.
    if [[ "$host" == bx && "$execution_env" == ambient ]]; then
      execution_env="docker:$task_capabilities"
    fi
  fi

  local route_env="${execution_env%%:*}" docker_image=""
  if [[ "$route_env" == docker ]]; then
    local contract_python
    contract_python="$(sugarbin_contract_python)" || return $?
    local environment_json
    environment_json="$("$contract_python" "$script_dir/../tools/sugar-build/contract.py" resolve-environment "$execution_env")" || return $?
    docker_image="$("$contract_python" -c 'import json,sys; print(json.load(sys.stdin)["image"])' <<<"$environment_json")"
  fi

  local observed_platform
  observed_platform="$(sugar_exec_platform_key)"
  if [[ "$host" == local ]]; then
    sugar_exec_validate_route "$host" "$route_env" "$requested_platform" "$observed_platform" || return $?
  elif [[ "$host" == bx ]]; then
    [[ "$route_env" == ambient || "$route_env" == docker ]] || { echo "unsupported execution route: host=$host env=$execution_env" >&2; return 2; }
  else
    sugar_exec_validate_route "$host" "$execution_env" "$requested_platform" "$observed_platform" || return $?
  fi

  if [[ "$subcommand" == explain ]]; then
    [[ "$saw_boundary" == 0 ]] || { echo "sugarbin: explain does not accept a command" >&2; return 2; }
    printf 'host=%s\n' "$host"
    printf 'env=%s\n' "$execution_env"
    printf 'platform=%s\n' "$observed_platform"
    printf 'capabilities=%s\n' "$task_capabilities"
    printf 'task=%s\n' "$task"
    printf 'needs=%s\n' "$needs"
    return 0
  fi

  local resolved_first="" resolved_sugar="" resolved_dir="" injection_dir="" requested_bin resolved
  local -a resolved_bins=()
  local -a resolved_paths=()
  if [[ "$host" == local && ( -n "$needs" || "$subcommand" == build ) ]]; then
    IFS=',' read -r -a resolved_bins <<<"${needs:-sugar}"
    for requested_bin in "${resolved_bins[@]}"; do
      [[ -n "$requested_bin" ]] || continue
      local -a resolver_args=(--bin "$requested_bin")
      [[ -z "$requested_platform" ]] || resolver_args+=(--platform "$requested_platform")
      resolved="$(env -u SUGAR_BIN "$script_dir/sugarbin" "${resolver_args[@]}")" || return $?
      resolved_paths+=("$resolved")
      [[ -n "$resolved_first" ]] || resolved_first="$resolved"
      [[ "$requested_bin" != sugar ]] || resolved_sugar="$resolved"
    done
    if [[ "$subcommand" == build ]]; then return 0; fi
    local run_root="${SUGAR_BINARY_CACHE_DIR:-${HOME}/.cache/sugar/binaries}/.runs"
    mkdir -p "$run_root"
    injection_dir="$(mktemp -d "$run_root/run.XXXXXX")"
    local resolved_path
    for resolved_path in "${resolved_paths[@]}"; do
      [[ -e "$injection_dir/$(basename "$resolved_path")" ]] \
        || ln -s "$resolved_path" "$injection_dir/$(basename "$resolved_path")"
    done
    resolved_dir="$injection_dir"
    resolved_sugar="${resolved_sugar:-$resolved_first}"
    export SUGAR_BIN="$resolved_dir/$(basename "$resolved_sugar")" SUGAR_BINARY_DIR="$resolved_dir"
    export PATH="$resolved_dir:$PATH"
  fi

  [[ "$subcommand" == build || ( ${#command[@]} -gt 0 && ( "$saw_boundary" == 1 || -n "$task" ) ) ]] || {
    printf 'sugarbin: %s requires -- followed by a command\n' "$subcommand" >&2
    return 2
  }
  local -a cargo_args=()
  if [[ "$subcommand" == cargo ]]; then cargo_args=("${command[@]}"); command=(cargo "${command[@]}"); fi
  if [[ "$host" == local ]]; then
    local local_status=0
    set +e
    sugar_exec_local_run "${command[@]}"
    local_status=$?
    set -e
    [[ -z "$injection_dir" ]] || rm -rf "$injection_dir"
    return "$local_status"
  fi

  # shellcheck source=bin/lib/sugar-bx.sh
  source "$script_dir/lib/sugar-bx.sh"
  SUGAR_BX_PATH_PREFIXES=()
  SUGAR_BX_ENV_NAMES=()
  SUGAR_BX_SYNC_BACKS=()
  ((${#path_prefixes[@]} == 0)) || SUGAR_BX_PATH_PREFIXES=("${path_prefixes[@]}")
  ((${#env_names[@]} == 0)) || SUGAR_BX_ENV_NAMES=("${env_names[@]}")
  ((${#sync_backs[@]} == 0)) || SUGAR_BX_SYNC_BACKS=("${sync_backs[@]}")
  SUGAR_BX_PYTHON_ENV="${python_env_flag:-${BCARGO_PYTHON_ENV:-1}}"
  local repo_root local_cwd status=0 pair
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$repo_root" ]] || { echo "sugarbin: must be run from inside a git checkout" >&2; return 2; }
  local_cwd="$(pwd -P)"
  sugar_bx_init "$repo_root" "$local_cwd" || return $?
  sugar_bx_sync_workspace || return $?
  if [[ "$route_env" == docker ]]; then
    local remote_needs="$needs" remote_platform="${requested_platform:-linux-x86_64}"
    local setup="set -e; cd $(sugar_bx_quote "$SUGAR_BX_REPO"); rm -rf $(sugar_bx_quote "$SUGAR_BX_ROOT/artifacts"); mkdir -p $(sugar_bx_quote "$SUGAR_BX_ROOT/artifacts"); printf '{\"artifacts\":[' >$(sugar_bx_quote "$SUGAR_BX_ROOT/required-artifacts.json"); first=1; needs=$(sugar_bx_quote "$remote_needs"); IFS=,; for b in \$needs; do [ -n \"\$b\" ] || continue; r=\$(env -u SUGAR_BIN bin/sugarbin --platform $(sugar_bx_quote "$remote_platform") --bin \"\$b\"); cp \"\$r\" $(sugar_bx_quote "$SUGAR_BX_ROOT/artifacts")/\"\$b\"; sum=\$(sha256sum $(sugar_bx_quote "$SUGAR_BX_ROOT/artifacts")/\"\$b\" | cut -d' ' -f1); [ \$first = 1 ] || printf ',' >>$(sugar_bx_quote "$SUGAR_BX_ROOT/required-artifacts.json"); first=0; printf '{\"name\":\"%s\",\"sha256\":\"%s\"}' \"\$b\" \"\$sum\" >>$(sugar_bx_quote "$SUGAR_BX_ROOT/required-artifacts.json"); done; printf ']}' >>$(sugar_bx_quote "$SUGAR_BX_ROOT/required-artifacts.json")"
    sugar_bx_ssh "bash -lc $(sugar_bx_quote "$setup")" || return $?
    set +e
    sugar_bx_run_docker "$docker_image" "${command[@]}"
    status=$?
    set -e
    sugar_bx_finish "$status"
    return $?
  fi
  if [[ -n "$needs" || "$subcommand" == build ]]; then
    local remote_needs="${needs:-sugar}" remote_platform="${requested_platform:-linux-x86_64}"
    if [[ "$subcommand" == build ]]; then
      set +e
      sugar_bx_ssh "cd $(sugar_bx_quote "$SUGAR_BX_REPO") && bin/sugarbin build --platform $(sugar_bx_quote "$remote_platform") --needs $(sugar_bx_quote "$remote_needs")"
      status=$?
      set -e
      sugar_bx_finish "$status"
      return $?
    fi
    local remote_setup="first= sugar= parent= needs=$(sugar_bx_quote "$remote_needs"); IFS=,; for b in \$needs; do r=\$(env -u SUGAR_BIN bin/sugarbin --platform $(sugar_bx_quote "$remote_platform") --bin \"\$b\") || exit; [ -n \"\$first\" ] || { first=\"\$r\"; parent=\$(dirname \"\$(dirname \"\$r\")\"); }; [ \"\$b\" != sugar ] || sugar=\"\$r\"; done; mkdir -p \"\$parent/.runs\"; dir=\$(mktemp -d \"\$parent/.runs/run.XXXXXX\") || exit; IFS=,; for b in \$needs; do [ -e \"\$dir/\$b\" ] && continue; r=\$(env -u SUGAR_BIN bin/sugarbin --platform $(sugar_bx_quote "$remote_platform") --bin \"\$b\") || { rm -rf \"\$dir\"; exit; }; ln -s \"\$r\" \"\$dir/\$b\" || { rm -rf \"\$dir\"; exit; }; done; [ -n \"\$sugar\" ] || sugar=\"\$first\"; export SUGAR_BIN=\"\$dir/\$(basename \"\$sugar\")\" SUGAR_BINARY_DIR=\"\$dir\" PATH=\"\$dir:\$PATH\"; "
    command=(bash -lc "$remote_setup \"\$@\"; status=\$?; rm -rf \"\$dir\"; exit \$status" bash "${command[@]}")
  fi
  if [[ "$subcommand" == cargo ]]; then
    sugarbin_bx_cargo "$repo_root"
    return $?
  fi
  set +e
  sugar_bx_run_ambient "${command[@]}"
  status=$?
  set -e
  if [[ "$status" == 0 ]]; then
    if ((${#SUGAR_BX_SYNC_BACKS[@]} != 0)); then
      for pair in "${SUGAR_BX_SYNC_BACKS[@]}"; do
        sugar_bx_sync_back "${pair%%:*}" "${pair#*:}" || { status=$?; break; }
      done
    fi
  fi
  sugar_bx_finish "$status"
}

sugarbin_bx_cargo() {
  local repo_root="$1"
  local profile=debug manifest_path="" target_dir_arg="" arg
  local i
  for ((i=0; i<${#cargo_args[@]}; i++)); do
    arg="${cargo_args[$i]}"
    case "$arg" in
      --release) profile=release ;;
      --manifest-path) ((i+1<${#cargo_args[@]})) && manifest_path="${cargo_args[$((i+1))]}" ;;
      --manifest-path=*) manifest_path="${arg#--manifest-path=}" ;;
      --target-dir) ((i+1<${#cargo_args[@]})) && target_dir_arg="${cargo_args[$((i+1))]}" ;;
      --target-dir=*) target_dir_arg="${arg#--target-dir=}" ;;
    esac
  done

  local local_cwd="$(pwd -P)" local_target_dir remote_target_dir path
  if [[ -n "$target_dir_arg" ]]; then
    [[ "$target_dir_arg" == /* ]] && local_target_dir="$target_dir_arg" || local_target_dir="$local_cwd/$target_dir_arg"
  elif [[ -n "$manifest_path" ]]; then
    [[ "$manifest_path" == /* ]] && path="$manifest_path" || path="$local_cwd/$manifest_path"
    local_target_dir="$(dirname "$path")/target"
  else
    local_target_dir="$local_cwd/target"
  fi
  case "$local_target_dir" in
    "$repo_root") remote_target_dir="$SUGAR_BX_REPO" ;;
    "$repo_root"/*) remote_target_dir="$SUGAR_BX_REPO/${local_target_dir#"$repo_root"/}" ;;
    *) remote_target_dir="$local_target_dir" ;;
  esac

  local wants_sugar=0 bin
  for bin in ${sync_bins[@]+"${sync_bins[@]}"}; do [[ "$bin" == sugar ]] && wants_sugar=1; done
  local stamp="" repo="" remote_platform="${BCARGO_REMOTE_BINARY_PLATFORM:-linux-x86_64}"
  if [[ "$wants_sugar" == 1 ]]; then
    stamp="${SUGAR_BINARY_SOURCE_STAMP:-}"
    [[ -n "$stamp" ]] || stamp="$("$script_dir/sugarbin" --print-source-stamp)" || return $?
    repo="${SUGAR_BINARY_REPO:-}"
    if [[ -z "$repo" ]] && command -v gh >/dev/null 2>&1; then repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)"; fi
  fi

  local assignments="" remote_bin="$remote_target_dir/$profile/sugar" shelf_ready=0 skip_cargo=0 cmd
  if [[ -n "$stamp" ]]; then
    assignments="SUGAR_BINARY_SOURCE_STAMP=$(sugar_bx_quote "$stamp") SUGAR_BINARY_TARGET_ROOT=$(sugar_bx_quote "$remote_target_dir") "
    [[ -z "$repo" ]] || assignments+="SUGAR_BINARY_REPO=$(sugar_bx_quote "$repo") "
    cmd="cd $(sugar_bx_quote "$SUGAR_BX_REPO") && resolved=\"\$(${assignments}SUGAR_BINARY_ALLOW_BUILD='0' bin/sugarbin --profile $(sugar_bx_quote "$profile") --platform $(sugar_bx_quote "$remote_platform"))\" && mkdir -p $(sugar_bx_quote "$(dirname "$remote_bin")") && if [ \"\$resolved\" != $(sugar_bx_quote "$remote_bin"); then cp \"\$resolved\" $(sugar_bx_quote "$remote_bin"); fi && chmod +x $(sugar_bx_quote "$remote_bin")"
    if sugar_bx_ssh "bash -lc $(sugar_bx_quote "$cmd")"; then shelf_ready=1; fi
    if [[ "$shelf_ready" == 1 && "${cargo_args[0]:-}" == build && ${#sync_bins[@]} -eq 1 ]]; then
      local package_ok=0 binary_ok=0 other=0 value
      for ((i=0; i<${#cargo_args[@]}; i++)); do
        arg="${cargo_args[$i]}"
        case "$arg" in
          -p|--package) ((i++)); value="${cargo_args[$i]:-}"; [[ "$value" == sugar-cli ]] && package_ok=1 || other=1 ;;
          -p=*|--package=*) value="${arg#*=}"; [[ "$value" == sugar-cli ]] && package_ok=1 || other=1 ;;
          --bin) ((i++)); value="${cargo_args[$i]:-}"; [[ "$value" == sugar ]] && binary_ok=1 || other=1 ;;
          --bin=*) value="${arg#*=}"; [[ "$value" == sugar ]] && binary_ok=1 || other=1 ;;
        esac
      done
      [[ "$package_ok" == 1 && "$binary_ok" == 1 && "$other" == 0 ]] && skip_cargo=1
    fi
  fi

  local status=0 remote_cwd="$SUGAR_BX_REPO" inner path_prefix="$remote_target_dir/$profile"
  [[ -z "$SUGAR_BX_REL_CWD" ]] || remote_cwd="$SUGAR_BX_REPO/$SUGAR_BX_REL_CWD"
  if [[ "$skip_cargo" != 1 ]]; then
    if [[ "${SUGAR_BX_PYTHON_ENV:-1}" != 0 ]]; then
      set +e
      sugar_bx_ssh "cd $(sugar_bx_quote "$SUGAR_BX_REPO") && BCARGO_PYTHON_VENV=$(sugar_bx_quote "$SUGAR_BX_ROOT/python-kit-env") make --quiet bcargo-python-kit-env"
      status=$?
      set -e
      if [[ "$status" != 0 ]]; then sugar_bx_finish "$status"; return $?; fi
      path_prefix+=":$SUGAR_BX_ROOT/python-kit-env/bin"
    fi
    inner="cd $(sugar_bx_quote "$remote_cwd") && "
    [[ "${SUGAR_BX_PYTHON_ENV:-1}" == 0 ]] || inner+="PYTHON=$(sugar_bx_quote "$SUGAR_BX_ROOT/python-kit-env/bin/python") "
    [[ -z "$stamp" ]] || inner+="SUGAR_BUILD_STAMP=$(sugar_bx_quote "$stamp") "
    inner+="PATH=$(sugar_bx_quote "$path_prefix"):\$PATH exec cargo"
    for arg in "${cargo_args[@]}"; do
      if [[ "$arg" == "$repo_root" ]]; then arg="$SUGAR_BX_REPO"; elif [[ "$arg" == "$repo_root"/* ]]; then arg="$SUGAR_BX_REPO/${arg#"$repo_root"/}"; fi
      inner+=" $(sugar_bx_quote "$arg")"
    done
    set +e; sugar_bx_ssh "bash -lc $(sugar_bx_quote "$inner")"; status=$?; set -e
  fi
  if [[ "$status" != 0 ]]; then sugar_bx_finish "$status"; return $?; fi

  if [[ -n "$stamp" && "$shelf_ready" != 1 ]]; then
    cmd="cd $(sugar_bx_quote "$SUGAR_BX_REPO") && ${assignments}SUGAR_BINARY_ALLOW_BUILD='0' bin/sugarbin --profile $(sugar_bx_quote "$profile") --platform $(sugar_bx_quote "$remote_platform") >/dev/null"
    sugar_bx_ssh "bash -lc $(sugar_bx_quote "$cmd")" || echo "sugarbin: remote sugarbin publish did not complete for stamp $stamp" >&2
  fi
  for bin in ${sync_bins[@]+"${sync_bins[@]}"}; do
    sugar_bx_sync_back "$remote_target_dir/$profile/$bin" "$local_target_dir/$profile/$bin" || { status=$?; break; }
  done
  sugar_bx_finish "$status"
}

case "${1:-}" in
  run|cargo|build|explain)
    subcommand="$1"
    shift
    dispatch_execution_subcommand "$subcommand" "$@"
    exit $?
    ;;
esac

usage() {
  cat <<'EOF'
usage: bin/sugarbin [--bin <name>] [--profile release|debug] [--platform <auto|key>] [--print-source-stamp]

Resolve a Sugar workspace binary by source stamp:
  SUGAR_BIN override -> local target by stamp -> shelf by stamp -> build + publish.

The stamp is ONE hash over the whole implementations/rust tree, shared by
every published binary: change any Rust source and every binary rebuilds;
change only Python and every binary stays cache-hot. --bin selects which
published binary to resolve (default: sugar). Known names:
  sugar                       sugar-cli
  sugar-ra-oracle               sugar-ra-oracle
  sugar-lsp                    sugar-lsp
  sugar-walk-rpc               sugar-walk
  witness_rpc                  sugar-lift-rust-cargo-test-witness
  discharge_cli                sugar-lift-rust-cargo-test-witness
  rust_test_assertions_rpc     sugar-lift-rust-tests
  discharge_sweep              sugar-lift-rust-tests
  sugar-ir-smt-lib              sugar-ir-compiler-smt-lib
  sugar-ir-lean                 sugar-ir-compiler-lean
  sugar-ir-coq                   sugar-ir-compiler-coq
  sugar-ir-maude                 sugar-ir-compiler-maude

  --print-source-stamp prints the canonical Rust build-input tree stamp and exits.
On success, prints exactly the binary path to stdout. Diagnostics go to stderr.
EOF
}

bin_name="sugar"
profile="release"
platform_override="auto"
print_source_stamp=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --bin)
      [[ $# -ge 2 ]] || { echo "sugarbin: --bin requires a value" >&2; exit 2; }
      bin_name="$2"
      shift 2
      ;;
    --profile)
      [[ $# -ge 2 ]] || { echo "sugarbin: --profile requires a value" >&2; exit 2; }
      profile="$2"
      shift 2
      ;;
    --platform)
      [[ $# -ge 2 ]] || { echo "sugarbin: --platform requires a value" >&2; exit 2; }
      platform_override="$2"
      shift 2
      ;;
    --print-source-stamp)
      print_source_stamp=1
      shift
      ;;
    --help | -h)
      usage
      exit 0
      ;;
    *)
      echo "sugarbin: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$profile" in
  release | debug) ;;
  *) echo "sugarbin: --profile must be release or debug" >&2; exit 2 ;;
esac

package_for_bin() {
  case "$1" in
    sugar) printf 'sugar-cli\n' ;;
    sugar-ra-oracle) printf 'sugar-ra-oracle\n' ;;
    sugar-lsp) printf 'sugar-lsp\n' ;;
    sugar-walk-rpc) printf 'sugar-walk\n' ;;
    witness_rpc) printf 'sugar-lift-rust-cargo-test-witness\n' ;;
    discharge_cli) printf 'sugar-lift-rust-cargo-test-witness\n' ;;
    rust_test_assertions_rpc) printf 'sugar-lift-rust-tests\n' ;;
    discharge_sweep) printf 'sugar-lift-rust-tests\n' ;;
    sugar-ir-smt-lib) printf 'sugar-ir-compiler-smt-lib\n' ;;
    sugar-ir-lean) printf 'sugar-ir-compiler-lean\n' ;;
    sugar-ir-coq) printf 'sugar-ir-compiler-coq\n' ;;
    sugar-ir-maude) printf 'sugar-ir-compiler-maude\n' ;;
    *)
      echo "sugarbin: unknown --bin '$1'; run bin/sugarbin --help for the published set" >&2
      return 1
      ;;
  esac
}

package="$(package_for_bin "$bin_name")" || exit 2

repo_root="$(git -C "$script_dir/.." rev-parse --show-toplevel 2>/dev/null || (cd "$script_dir/.." && pwd -P))"
repo_root="$(cd "$repo_root" && pwd -P)"
rust_workspace="$repo_root/implementations/rust"
shelf_tag="${SUGAR_BINARY_SHELF_TAG:-sugar-binary-shelf}"

log() {
  printf 'sugarbin: %s\n' "$*" >&2
}

quote_sh() {
  printf "'"
  printf "%s" "$1" | sed "s/'/'\\\\''/g"
  printf "'"
}

platform_key() {
  if [[ "$platform_override" != "auto" ]]; then
    printf '%s\n' "$platform_override"
    return 0
  fi
  local os arch
  os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  arch="$(uname -m | tr '[:upper:]' '[:lower:]')"
  case "$arch" in
    amd64 | x64) arch="x86_64" ;;
    aarch64) arch="arm64" ;;
  esac
  case "$os" in
    darwin) os="darwin" ;;
    linux) os="linux" ;;
  esac
  printf '%s-%s\n' "$os" "$arch"
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

require_b3sum() {
  if command -v b3sum >/dev/null 2>&1; then
    return 0
  fi
  log "crime=missing-blake3-tool owner=bin/sugarbin illegal shape=b3sum not found on PATH replacement=install b3sum (macOS: brew install b3sum or cargo install b3sum; Debian/Ubuntu: apt install b3sum or cargo install b3sum)"
  return 1
}

rust_tree_stream() {
  python3 - "$rust_workspace" <<'PY'
import os
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
if not root.is_dir():
    raise SystemExit(f"rust workspace not found: {root}")

# The sugar binary artifact is keyed only by its build-input closure: the Rust
# workspace bytes Cargo sees for sugar-cli. Repo metadata and other language
# kits are intentionally outside this cache boundary.
SKIP_DIRS = {
    ".git",
    ".hg",
    ".jj",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    ".sugar",
    "node_modules",
    "target",
    "__pycache__",
}
SKIP_FILES = {
    ".DS_Store",
}


def emit(label: bytes, value: bytes) -> None:
    out = sys.stdout.buffer
    out.write(str(len(label)).encode("ascii"))
    out.write(b":")
    out.write(label)
    out.write(str(len(value)).encode("ascii"))
    out.write(b":")
    out.write(value)


for dirpath, dirnames, filenames in os.walk(root, topdown=True, followlinks=False):
    dirnames[:] = sorted(name for name in dirnames if name not in SKIP_DIRS)
    rel_dir = Path(dirpath).relative_to(root)
    for filename in sorted(name for name in filenames if name not in SKIP_FILES):
        path = Path(dirpath) / filename
        rel = (rel_dir / filename).as_posix()
        st = os.lstat(path)
        if stat.S_ISLNK(st.st_mode):
            kind = b"symlink"
            content = os.readlink(path).encode("utf-8", "surrogateescape")
        elif stat.S_ISREG(st.st_mode):
            kind = b"file"
            content = path.read_bytes()
        else:
            continue
        executable = b"1" if (st.st_mode & 0o111) else b"0"
        emit(b"path", rel.encode("utf-8", "surrogateescape"))
        emit(b"kind", kind)
        emit(b"exec", executable)
        emit(b"bytes", content)
PY
}

source_stamp() {
  if [[ -n "${SUGAR_BINARY_SOURCE_STAMP:-}" ]]; then
    printf '%s\n' "$SUGAR_BINARY_SOURCE_STAMP"
    return 0
  fi
  require_b3sum
  local digest
  digest="$(rust_tree_stream | b3sum -l 64 --no-names | awk '{print $1}')"
  [[ "$digest" =~ ^[0-9a-f]{128}$ ]] || {
    log "crime=invalid-blake3-output owner=bin/sugarbin illegal shape=b3sum -l 64 emitted '$digest' replacement=repair or upgrade b3sum so it emits 64-byte lowercase hex digests"
    return 1
  }
  printf 'blake3-512:%s\n' "$digest"
}

attestation_git_head() {
  git -C "$repo_root" rev-parse HEAD 2>/dev/null || true
}

stamp_for_filename() {
  printf '%s\n' "${1//:/_}"
}

artifact_name() {
  local identity="$1"
  printf '%s-%s-%s-%s\n' "$bin_name" "$(platform_key)" "$profile" "$(stamp_for_filename "$identity")"
}

tool_versions() {
  rustc_verbose="$(rustc -vV)" || return 1
  cargo_verbose="$("${SUGAR_BINARY_CARGO:-cargo}" -vV)" || return 1
  target_triple="$(printf '%s\n' "$rustc_verbose" | sed -n 's/^host: //p' | head -1)"
  [[ -n "$target_triple" ]] || { log "rustc -vV did not report a host target"; return 1; }
}

build_identity() {
  local stamp="$1"
  require_b3sum || return 1
  python3 - "$stamp" "$rustc_verbose" "$cargo_verbose" "$(platform_key)" "$target_triple" "$profile" "" "$package" "$bin_name" <<'PY' | b3sum -l 64 --no-names | awk '{print "blake3-512:" $1}'
import sys
def emit(label, value):
    label = label.encode(); value = value.encode()
    sys.stdout.buffer.write(str(len(label)).encode() + b":" + label)
    sys.stdout.buffer.write(str(len(value)).encode() + b":" + value)
for label, value in zip(("sourceStamp", "rustcVersionVerbose", "cargoVersionVerbose",
                         "platform", "targetTriple", "profile", "sortedFeatures",
                         "package", "binary"), sys.argv[1:]):
    emit(label, value)
PY
}

artifact_manifest_path() { printf '%s.sugarbin.json\n' "$1"; }

write_artifact_manifest() {
  local binary_path="$1" stamp="$2" identity="$3" manifest sha
  manifest="$(artifact_manifest_path "$binary_path")"
  sha="$(sha256_file "$binary_path")"
  python3 - "$manifest" "$bin_name" "$package" "$stamp" "$identity" "$(platform_key)" "$target_triple" "$profile" "$rustc_verbose" "$cargo_verbose" "$sha" <<'PY'
import json, os, sys, tempfile
path, binary, package, stamp, identity, platform, target, profile, rustc, cargo, sha = sys.argv[1:]
data = {"schema": 1, "binary": binary, "package": package, "sourceStamp": stamp,
        "buildIdentity": identity, "platform": platform, "targetTriple": target,
        "profile": profile, "features": [], "rustc": rustc, "cargo": cargo,
        "sha256": sha, "built": True, "executed": False}
os.makedirs(os.path.dirname(path), exist_ok=True)
fd, tmp = tempfile.mkstemp(prefix=".sugarbin-manifest-", dir=os.path.dirname(path))
with os.fdopen(fd, "w") as out: json.dump(data, out, indent=2, sort_keys=True); out.write("\n")
os.replace(tmp, path)
PY
}

verify_artifact_manifest() {
  local binary_path="$1" stamp="$2" identity="$3" label="$4" manifest
  manifest="$(artifact_manifest_path "$binary_path")"
  [[ -f "$binary_path" && -x "$binary_path" ]] || return 1
  [[ -f "$manifest" ]] || { log "$label skipped: no executable manifest at $manifest"; return 1; }
  python3 - "$manifest" "$binary_path" "$bin_name" "$package" "$stamp" "$identity" "$(platform_key)" "$target_triple" "$profile" "$rustc_verbose" "$cargo_verbose" <<'PY'
import hashlib, json, sys
manifest, path, binary, package, stamp, identity, platform, target, profile, rustc, cargo = sys.argv[1:]
try:
    with open(manifest, encoding="utf-8") as f: data = json.load(f)
except Exception as e:
    print(f"sugarbin: invalid artifact manifest: {e}", file=sys.stderr); raise SystemExit(1)
expected = {"schema": 1, "binary": binary, "package": package, "sourceStamp": stamp,
            "buildIdentity": identity, "platform": platform, "targetTriple": target,
            "profile": profile, "features": [], "rustc": rustc, "cargo": cargo,
            "built": True, "executed": False}
for key, value in expected.items():
    if data.get(key) != value:
        print(f"sugarbin: artifact identity mismatch: {key}", file=sys.stderr); raise SystemExit(1)
with open(path, "rb") as f: actual = hashlib.sha256(f.read()).hexdigest()
if data.get("sha256") != actual:
    print("sugarbin: artifact checksum mismatch", file=sys.stderr); raise SystemExit(1)
PY
}

github_repo() {
  if [[ -n "${SUGAR_BINARY_REPO:-}" ]]; then
    printf '%s\n' "$SUGAR_BINARY_REPO"
    return 0
  fi
  gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || return 1
}

cache_dir() {
  printf '%s\n' "${SUGAR_BINARY_CACHE_DIR:-$HOME/.cache/sugar/binaries}"
}

publish_if_absent() {
  local bin="$1" stamp="$2" name="$3" manifest
  manifest="$(artifact_manifest_path "$bin")"
  [[ "${SUGAR_BINARY_PUBLISH:-1}" != "0" ]] || { log "publish disabled by SUGAR_BINARY_PUBLISH=0"; return 0; }
  command -v gh >/dev/null 2>&1 || { log "gh not found; not publishing $name"; return 0; }
  local repo
  repo="$(github_repo)" || { log "gh repo identity unavailable; not publishing $name"; return 0; }
  gh release view "$shelf_tag" --repo "$repo" >/dev/null 2>&1 \
    || gh release create "$shelf_tag" \
      --repo "$repo" \
      --title "Sugar binary shelf" \
      --notes "Dumb shelf for stamp-addressed Sugar test binaries." >/dev/null 2>&1 \
    || { log "could not create shelf release; not publishing $name"; return 0; }
  local shelf_assets
  shelf_assets="$(gh release view "$shelf_tag" --repo "$repo" --json assets --jq '.assets[].name')"
  if grep -Fxq "$name" <<<"$shelf_assets" && grep -Fxq "$name.sugarbin.json" <<<"$shelf_assets"; then
    log "shelf already has $name"
    return 0
  fi
  local actor sha tmp asset meta
  actor="$(gh api user --jq .login 2>/dev/null || printf unknown)"
  sha="$(sha256_file "$bin")"
  tmp="$(mktemp -d)"
  asset="$tmp/$name"
  meta="$tmp/$name.metadata.json"
  cp "$bin" "$asset"
  chmod +x "$asset"
  python3 - "$meta" "$repo" "$actor" "$stamp" "$(artifact_name "$stamp")" "$(platform_key)" "$profile" "$sha" "$bin" <<'PY'
import json
import sys
from datetime import datetime, timezone

path, repo, actor, stamp, artifact, platform, profile, sha256, binary = sys.argv[1:]
with open(path, "w", encoding="utf-8") as out:
    json.dump(
        {
            "artifact": artifact,
            "repo": repo,
            "actor": actor,
            "buildStamp": stamp,
            "platform": platform,
            "profile": profile,
            "sha256": sha256,
            "source": binary,
            "publishedAt": datetime.now(timezone.utc).isoformat(),
        },
        out,
        indent=2,
        sort_keys=True,
    )
    out.write("\n")
PY
  cp "$manifest" "$tmp/$name.sugarbin.json"
  gh release upload "$shelf_tag" "$asset" "$meta" "$tmp/$name.sugarbin.json" --clobber \
    --repo "$repo" >/dev/null 2>&1 \
    && log "published $name as $actor" \
    || log "publish failed or raced for $name; continuing"
  rm -rf "$tmp"
}

verify_attestation_if_present() {
  local bin="$1" stamp="$2"
  command -v gh >/dev/null 2>&1 || return 0
  local repo
  repo="$(github_repo)" || return 0
  local head
  head="$(attestation_git_head)"
  [[ -n "$head" ]] || { log "attestation skipped for $(basename "$bin"): git head unavailable; stamp tooth remains decisive"; return 0; }
  gh attestation verify "$bin" --repo "$repo" --source-digest "$head" >/dev/null 2>&1 \
    && log "attestation verified for $(basename "$bin")" \
    || log "attestation absent or unverifiable for $(basename "$bin"); stamp tooth remains decisive"
}

pull_from_shelf() {
  local stamp="$1" identity="$2" name="$3"
  [[ "${SUGAR_BINARY_NO_SHELF:-0}" != "1" ]] || { log "shelf pull disabled by SUGAR_BINARY_NO_SHELF=1"; return 1; }
  command -v gh >/dev/null 2>&1 || { log "gh not found; skipping shelf pull"; return 1; }
  local repo
  repo="$(github_repo)" || { log "gh repo identity unavailable; skipping shelf pull"; return 1; }
  local dir download_dir candidate candidate_dir manifest
  dir="$(cache_dir)"
  candidate_dir="$dir/$name"
  candidate="$candidate_dir/$bin_name"
  manifest="$(artifact_manifest_path "$candidate")"
  if verify_artifact_manifest "$candidate" "$stamp" "$identity" "prebuilt cache"; then
    log "prebuilt cache hit for $name"
    printf '%s\n' "$candidate"
    return 0
  fi
  download_dir="$dir/.downloads/$name"
  mkdir -p "$download_dir"
  if ! gh release download "$shelf_tag" --repo "$repo" --pattern "$name" --pattern "$name.sugarbin.json" --dir "$download_dir" >/dev/null 2>&1; then
    log "shelf miss for $name"
    return 1
  fi
  local downloaded="$download_dir/$name" downloaded_manifest="$download_dir/$name.sugarbin.json"
  [[ -f "$downloaded" && -f "$downloaded_manifest" ]] || { log "shelf assets lack a verifiable executable manifest for $name"; return 1; }
  chmod +x "$downloaded"
  mkdir -p "$candidate_dir"
  cp "$downloaded" "$candidate"
  cp "$downloaded_manifest" "$manifest"
  chmod +x "$candidate"
  verify_artifact_manifest "$candidate" "$stamp" "$identity" "downloaded shelf artifact" || return 1
  verify_attestation_if_present "$candidate" "$stamp"
  printf '%s\n' "$candidate"
}

build_from_source() {
  local stamp="$1" identity="$2"
  log "building $bin_name once for this session (set SUGAR_BIN to skip)"
  local cargo_bin="${SUGAR_BINARY_CARGO:-cargo}"
  local args=(build --locked --manifest-path "$rust_workspace/Cargo.toml" -p "$package" --bin "$bin_name")
  if [[ "$profile" == "release" ]]; then
    args+=(--release)
  fi
  SUGAR_BUILD_STAMP="$stamp" "$cargo_bin" "${args[@]}"
  local built="${SUGAR_BINARY_TARGET_ROOT:-$rust_workspace/target}/$profile/$bin_name"
  [[ -x "$built" ]] || { log "Cargo did not produce requested executable $built"; return 1; }
  write_artifact_manifest "$built" "$stamp" "$identity"
  rm -f "${SUGAR_BINARY_TARGET_ROOT:-$rust_workspace/target}/$profile/.sugarbin-source-stamp"
}

main() {
  if [[ "$print_source_stamp" == "1" ]]; then
    source_stamp
    return 0
  fi

  if [[ -n "${SUGAR_BIN:-}" ]]; then
    printf '%s\n' "$SUGAR_BIN"
    return 0
  fi

  local stamp identity name candidate built
  stamp="$(source_stamp)"
  tool_versions || return $?
  identity="$(build_identity "$stamp")"
  name="$(artifact_name "$identity")"

  candidate="${SUGAR_BINARY_TARGET_ROOT:-$rust_workspace/target}/$profile/$bin_name"
  if verify_artifact_manifest "$candidate" "$stamp" "$identity" "local target"; then
    publish_if_absent "$candidate" "$stamp" "$name"
    printf '%s\n' "$candidate"
    return 0
  fi

  if candidate="$(pull_from_shelf "$stamp" "$identity" "$name")"; then
    printf '%s\n' "$candidate"
    return 0
  fi

  if [[ "${SUGAR_BINARY_ALLOW_BUILD:-1}" == "0" ]]; then
    log "no matching $bin_name binary for stamp $stamp and build fallback disabled"
    return 1
  fi
  build_from_source "$stamp" "$identity"
  built="${SUGAR_BINARY_TARGET_ROOT:-$rust_workspace/target}/$profile/$bin_name"
  if ! verify_artifact_manifest "$built" "$stamp" "$identity" "built binary"; then
    log "built binary did not match requested stamp $stamp"
    return 1
  fi
  publish_if_absent "$built" "$stamp" "$name"
  printf '%s\n' "$built"
}

main "$@"
